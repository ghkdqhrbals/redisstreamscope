{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "service",
    "persistence",
    "config",
    "initialAdmin",
    "redis",
    "probes"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "RedisStreamScope uses one SQLite database and supports one replica."
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "accessModes", "size", "retain"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadOnlyMany", "ReadWriteMany"]
          }
        },
        "size": { "type": "string", "minLength": 1 },
        "retain": { "type": "boolean" }
      }
    },
    "config": {
      "type": "object",
      "required": ["publicURL", "secureCookies", "sessionTTL"],
      "properties": {
        "publicURL": { "type": "string" },
        "secureCookies": { "type": "boolean" },
        "sessionTTL": { "type": "string", "minLength": 1 }
      }
    },
    "initialAdmin": {
      "type": "object",
      "required": ["username", "displayName", "existingSecret", "passwordKey"],
      "properties": {
        "username": { "type": "string", "minLength": 3 },
        "displayName": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string" },
        "passwordKey": { "type": "string", "minLength": 1 }
      }
    },
    "redis": {
      "type": "object",
      "required": ["host", "port", "url", "nodes", "mode", "database", "auth", "tls"],
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "url": { "type": "string" },
        "nodes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mode": { "type": "string", "enum": ["standalone", "sentinel", "cluster"] },
        "database": { "type": "integer", "minimum": 0 },
        "auth": {
          "type": "object",
          "required": ["existingSecret", "passwordKey"],
          "properties": {
            "existingSecret": { "type": "string" },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        },
        "tls": {
          "type": "object",
          "required": ["enabled", "existingSecret", "caKey", "certKey", "keyKey"],
          "properties": {
            "enabled": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "caKey": { "type": "string" },
            "certKey": { "type": "string" },
            "keyKey": { "type": "string" }
          }
        }
      }
    }
  }
}
